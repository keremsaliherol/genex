@inject Microsoft.AspNetCore.Mvc.ViewFeatures.IFileVersionProvider Surum
@{
    var kirintilar = ViewData["Kirinti"] as IReadOnlyList<Kirinti> ?? [];
    var baslik = kirintilar.Count > 0 ? kirintilar[^1].Ad : "Genel bakış";
    var modul = (ViewContext.RouteData.Values["controller"] as string, ViewContext.RouteData.Values["action"] as string) switch
    {
        ("Home", _) => "genel",
        ("Musteri", _) => "musteri",
        ("Hesap", "Ekstre") => "ekstre",
        ("Hesap", _) => "hesap",
        ("Islem", _) => "islem",
        ("Rapor", _) => "rapor",
        _ => null
    };
    var menu = new (string Anahtar, string Adres, string Ikon, string Ad)[]
    {
        ("genel", "/", "squares-four", "Genel bakış"),
        ("musteri", "/Musteri", "users", "Müşteriler"),
        ("hesap", "/Hesap", "wallet", "Hesaplar"),
        ("islem", "/Islem/Yeni", "arrows-left-right", "İşlem yap"),
        ("ekstre", "/Hesap/Ekstre", "receipt", "Ekstre"),
        ("rapor", "/Rapor/AylikOzet", "chart-line", "Raporlar")
    };
    var izGirdileri = OracleIzUzantilari.Girdiler(Context);
    var bildirim = TempData["Bildirim"] as string;
    var bildirimHata = TempData["BildirimTur"] as string == "hata";
    var geriAl = TempData["BildirimGeriAl"] as string;
    // Oturumdaki kullanıcı: admin@hesapmasasi.local → "admin", rozet "AD"
    var kullanici = User.Identity?.Name ?? string.Empty;
    var kisaAd = kullanici.Split('@')[0];
    var harfler = (kisaAd.Length > 2 ? kisaAd[..2] : kisaAd).ToUpperInvariant();
}
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@baslik | Hesap Masası</title>
    <partial name="_BasEtiketleri" />
</head>
<body class="@(izGirdileri is null ? "iz-yok" : null)" data-sprite="@Surum.AddFileVersionToPath(Context.Request.PathBase, IkonluTagHelper.SpriteYolu)">
    <a class="skip-link" href="#icerik">İçeriğe atla</a>
    <div class="hm-shell" id="kabuk">
        <aside class="hm-sidebar" id="yan-menu" aria-label="Ana menü">
            <a class="hm-brand" href="/" aria-label="Hesap Masası, genel bakış">
                <span class="hm-brand-mark"><ikon ad="vault" /></span>
                <span class="hm-brand-name">Hesap Masası<small>Müşteri ve hesap yönetimi</small></span>
            </a>
            <nav class="hm-nav" aria-label="Modüller">
                @foreach (var m in menu)
                {
                    <a href="@m.Adres" title="@m.Ad" aria-current="@(modul == m.Anahtar ? "page" : null)"><ikon ad="@m.Ikon" /><span>@m.Ad</span></a>
                }
            </nav>
            <div class="hm-sidebar-foot">
                <div class="hm-baglanti" title="Oracle Database, FREEPDB1 servisi, HESAP şeması">
                    <span class="hm-dot" aria-hidden="true"></span><span class="metin">FREEPDB1 · HESAP</span>
                </div>
                <div class="metin">Demo verisi, kurgusal</div>
            </div>
        </aside>
        <div class="hm-backdrop" id="menu-perde" hidden></div>
        <div class="hm-main">
            <header class="hm-topbar">
                <button type="button" class="btn btn-ghost btn-icon hm-menu-btn" id="menu-dugme" aria-controls="yan-menu" aria-expanded="false" aria-label="Menüyü aç"><ikon ad="list" /></button>
                <nav class="hm-crumbs" aria-label="Konum">
                    <ol>
                        <li><a href="/">Hesap Masası</a></li>
                        @for (var i = 0; i < kirintilar.Count; i++)
                        {
                            if (i == kirintilar.Count - 1 || kirintilar[i].Adres is null)
                            {
                                <li aria-current="@(i == kirintilar.Count - 1 ? "page" : null)">@kirintilar[i].Ad</li>
                            }
                            else
                            {
                                <li><a href="@kirintilar[i].Adres">@kirintilar[i].Ad</a></li>
                            }
                        }
                    </ol>
                </nav>
                <div class="hm-search" role="search">
                    <ikon ad="magnifying-glass" />
                    <label class="visually-hidden" for="genel-arama">Müşteri veya hesap ara</label>
                    <input id="genel-arama" class="form-control" type="search" placeholder="Müşteri adı, müşteri no, hesap no" autocomplete="off"
                           role="combobox" aria-expanded="false" aria-controls="arama-sonuc" aria-autocomplete="list" />
                    <kbd>Ctrl K</kbd>
                    <div class="hm-search-results" id="arama-sonuc" role="listbox" aria-label="Arama sonuçları" hidden></div>
                </div>
                <div class="hm-top-eylem">
                    @if (izGirdileri is not null)
                    {
                        <button type="button" class="btn btn-ghost" id="iz-dugme" aria-pressed="false" aria-controls="iz" title="Oracle izi (Alt+O)">
                            <ikon ad="database" /><span class="etiket">Oracle izi</span><span class="iz-sayac" id="iz-sayac">@izGirdileri.Count</span>
                        </button>
                    }
                    <div class="dropdown">
                        <button type="button" class="btn btn-ghost" data-bs-toggle="dropdown" aria-expanded="false" aria-label="Kullanıcı menüsü">
                            <span class="hm-avatar" aria-hidden="true">@harfler</span><span class="etiket">@kisaAd</span><ikon ad="caret-down" class="ic-14" />
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end" style="min-width:250px">
                            <li class="px-3 py-2"><div class="fw-semibold">@kisaAd</div><div class="form-text m-0 text-truncate">@kullanici</div></li>
                            <li><hr class="dropdown-divider" /></li>
                            <li><h3 class="dropdown-header">Görünüm</h3></li>
                            <li><button type="button" class="dropdown-item" role="menuitemradio" aria-checked="false" data-tema="sistem">Sistem<ikon ad="check" class="ic-16 tik" /></button></li>
                            <li><button type="button" class="dropdown-item" role="menuitemradio" aria-checked="false" data-tema="acik">Açık<ikon ad="check" class="ic-16 tik" /></button></li>
                            <li><button type="button" class="dropdown-item" role="menuitemradio" aria-checked="false" data-tema="koyu">Koyu<ikon ad="check" class="ic-16 tik" /></button></li>
                            <li><hr class="dropdown-divider" /></li>
                            <li>
                                <form method="post" asp-controller="Giris" asp-action="Cikis">
                                    <button type="submit" class="dropdown-item"><ikon ad="sign-out" />Oturumu kapat</button>
                                </form>
                            </li>
                        </ul>
                    </div>
                </div>
            </header>
            <main id="icerik" class="hm-content" tabindex="-1">
                @RenderBody()
            </main>
        </div>
    </div>

    @await Component.InvokeAsync("OracleIzi")

    <div class="toast-alani" id="toast-alani" aria-live="polite">
        @if (bildirim is not null)
        {
            <div class="toast" role="status" data-otomatik data-bs-delay="@(geriAl is null ? 4000 : 6000)">
                <div class="toast-body">
                    <ikon ad="@(bildirimHata ? "warning-circle" : "check-circle")" class="@(bildirimHata ? "ic-hata" : null)" />
                    <span class="flex-grow-1">@bildirim</span>
                    @if (geriAl is not null)
                    {
                        <form method="post" action="@geriAl" asp-antiforgery="true"><button type="submit" class="btn btn-ghost btn-sm">Geri al</button></form>
                    }
                    <button type="button" class="btn-close" data-bs-dismiss="toast" aria-label="Kapat"></button>
                </div>
            </div>
        }
    </div>

    <div class="modal fade" id="onay-modal" tabindex="-1" aria-labelledby="onay-baslik" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header"><h2 class="modal-title" id="onay-baslik"></h2><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Kapat"></button></div>
                <div class="modal-body"><p class="mb-0" id="onay-metin"></p></div>
                <div class="modal-footer"><button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Vazgeç</button><button type="button" class="btn btn-danger" data-onayla></button></div>
            </div>
        </div>
    </div>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/uygulama.js" asp-append-version="true"></script>
    @if (ViewData["Grafik"] is true)
    {
        @* Chart.js yalnız grafikli sayfalarda (genel bakış, aylık özet, bakiye değişimi) *@
        <script src="~/lib/chart.js/chart.umd.js" asp-append-version="true"></script>
        <script src="~/js/grafik.js" asp-append-version="true"></script>
    }
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

@* İki layout'un ortak <head> içeriği: tema betiği, yazı tipleri ve stiller. Fontlar yerelde (css/fontlar.css,
   tools/on-yuz-varliklari.mjs üretir); dış kaynağa istek yok. *@
<script>
    // Tema tercihi boyamadan önce uygulanır; açık ve koyu arasında yanıp sönme olmaz.
    (function () {
        var r = document.documentElement, t = null;
        r.classList.add('js');
        try { t = localStorage.getItem('hm-tema'); } catch (e) { t = null; }
        if (t === 'acik') r.setAttribute('data-theme', 'light');
        else if (t === 'koyu') r.setAttribute('data-theme', 'dark');
        var d = r.getAttribute('data-theme') || (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
        r.setAttribute('data-bs-theme', d);
    })();
</script>
@* Ana metin fontu CSS'ten keşfedilmeden indirilmeye başlar: ilk boyamada yedek fonttan Geist'e zıplama olmaz.
   Adres fontlar.css'teki url ile aynı (sürüm eki yok), yoksa tarayıcı dosyayı iki kez indirir. *@
<link rel="preload" href="/fonts/geist-latin-wght-normal.woff2" as="font" type="font/woff2" crossorigin />
<link rel="stylesheet" href="~/css/fontlar.css" asp-append-version="true" />
<link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
<link rel="stylesheet" href="~/css/theme.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/uygulama.css" asp-append-version="true" />

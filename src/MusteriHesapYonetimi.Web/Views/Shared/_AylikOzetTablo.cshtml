@* PKG_RAPOR.AYLIK_OZET_* sonucu: işlem tipine göre adet ve bakiyeye etkisiyle toplam. Rapor ve detay sekmeleri kullanır. *@
@model IReadOnlyList<AylikOzetSatiri>
@if (Model.Count == 0)
{
    <partial name="_Bos" model='new BosDurum("calendar-blank", "Bu ay işlem yok", "Seçilen dönemde kayıtlı hareket bulunmuyor.")' />
}
else
{
    <div class="tablo-kap">
        <table class="table tablo">
            <thead>
                <tr>
                    <th scope="col">İşlem tipi</th>
                    <th scope="col" class="num">Adet</th>
                    <th scope="col" class="num">Toplam tutar</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var s in Model)
                {
                    <tr>
                        <td><islem-tipi deger="@s.Tip" /></td>
                        <td class="num">@TurkceBicim.Sayi(s.Adet)</td>
                        <td class="num"><tutar deger="@s.IsaretliToplam" isaretli="true" /></td>
                    </tr>
                }
            </tbody>
            <tfoot>
                <tr>
                    <td>Net bakiye etkisi</td>
                    <td class="num">@TurkceBicim.Sayi(Model.Sum(s => s.Adet))</td>
                    <td class="num"><tutar deger="@AylikOzetHesabi.NetEtki(Model)" isaretli="true" /></td>
                </tr>
            </tfoot>
        </table>
    </div>
}
